-- NOT a migration. Owner-run, ONE row, only after supabase/manual/diagnose_academic_year_dates.sql shows the
-- row really is the 2019 E.C. (2026-27) school year whose start date was left in 2018 E.C. — i.e. the
-- VERDICT HELPER at the bottom of the diagnostic shows 0 attendance / installments / payments / payroll from
-- before 2026-09-01 on that row.
--
-- Fill in the three placeholders, then run in the Supabase SQL editor:
--   <<ACADEMIC_YEAR_ID>>  the academic_years.id of the inconsistent row
--   <<NEW_YEAR_START>>    the correct start, 2026-09-11 (Meskerem 1, 2019 E.C.)
--   <<NEW_YEAR_END>>      the correct end,   2027-07-07 (Sene 30, 2019 E.C. — the 10th Ethiopian month)
--
-- It changes ONLY academic_years.year_start / year_end -- plus sem2_end when it would end after the corrected year
-- (Semester 2 ends when the year ends; the bad row has sem2_end = 2027-07-08) -- (the app derives the displayed year label from the dates,
-- so the stored gc_label/ec_label are only fallbacks and the next Save Calendar rewrites them). It refuses -- and
-- changes nothing -- if any fee has been billed, or any attendance recorded, outside the new dates: that means the
-- row also carries the PREVIOUS school year's history, and it must be split into two years by a person, not
-- shifted. It never touches fee schedules, installments, obligations, payments, adjustments, enrollments or
-- results, and never moves a record from one year to another. Semester 1 / break / Semester 2 start dates are left
-- as they are; the academic_years_dates_ordered constraint refuses the update if they don't fit the corrected year.
do $$
declare
  v_id    uuid := '<<ACADEMIC_YEAR_ID>>';
  v_start date := '<<NEW_YEAR_START>>';
  v_end   date := '<<NEW_YEAR_END>>';
  v_year  public.academic_years;
  v_n     integer;
begin
  select * into v_year from public.academic_years where id = v_id for update;
  if v_year.id is null then raise exception 'Academic year % not found', v_id; end if;
  if v_end <= v_start then raise exception 'The new end (%) must be after the new start (%)', v_end, v_start; end if;

  select count(*) into v_n
  from public.fee_installments fi join public.fee_schedules fs on fs.id = fi.fee_schedule_id
  where fs.academic_year_id = v_id and fi.period_month < date_trunc('month', v_start)::date;
  if v_n > 0 then
    raise exception 'Refusing: % fee installment(s) of this year are billed before %. The row carries the previous school year''s billing -- split it manually.', v_n, v_start;
  end if;

  select count(*) into v_n from public.attendance where date < v_start and date >= v_year.year_start;
  if v_n > 0 then
    raise exception 'Refusing: % attendance record(s) fall between the old start (%) and the new start (%). The row carries the previous school year''s history -- split it manually.', v_n, v_year.year_start, v_start;
  end if;

  select count(*) into v_n from public.attendance where date > v_end and date <= v_year.year_end;
  if v_n > 0 then
    raise exception 'Refusing: % attendance record(s) fall after the new end (%). Their days would no longer belong to this year.', v_n, v_end;
  end if;

  select count(*) into v_n from public.payroll_payments where month < to_char(v_start, 'YYYY-MM');
  if v_n > 0 then
    raise exception 'Refusing: % payroll payment(s) are for months before %. The row carries the previous school year''s payroll -- split it manually.', v_n, v_start;
  end if;

  -- the academic_years_validate_span trigger re-checks the result (<= 13 months, Semester 1 near the start)
  update public.academic_years
     set year_start = v_start,
         year_end   = v_end,
         sem2_end   = least(sem2_end, v_end)
   where id = v_id;

  raise notice 'Academic year % now runs % .. %', v_id, v_start, v_end;
end $$;
