# ---- Phase 2 (current): Supabase (Auth, Postgres, RLS, Realtime, Edge Functions) ----
# This is a "publishable" key (sb_publishable_...) — safe for the browser.
# Never put a service_role/secret key here or anywhere in client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Phase 3: Cloudflare R2 (file/image storage) ----
# Only the PUBLIC read URL belongs in the frontend. Never put R2 write/delete
# credentials in a Vite client bundle — those stay server-side (e.g. a
# Supabase Edge Function issuing signed upload URLs).
# VITE_R2_PUBLIC_URL=

# ---- Phase 4: Firebase Cloud Messaging (push notifications) ----
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
