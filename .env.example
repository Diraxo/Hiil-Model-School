# ---- Supabase (Auth, Postgres, RLS, Realtime, Edge Functions, Storage) ----
# This is a "publishable" key (sb_publishable_...) — safe for the browser.
# Never put a service_role/secret key here or anywhere in client code.
# All user-uploaded images/files live in PRIVATE Supabase Storage buckets and are
# reached through the authenticated client with short-lived signed URLs — there is
# nothing else to configure here for file storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Site URL (password-reset / auth email redirects) ----
# Leave BLANK for local development — the app then uses the current browser origin
# (e.g. http://localhost:5173), so reset links open your local dev server.
# In the production host (Vercel), set this to the deployed origin so password-reset
# emails always return users to production, e.g.:
#   VITE_SITE_URL=https://hiil-model-school.vercel.app
# This value must also be listed under Supabase > Authentication > URL Configuration >
# Redirect URLs, otherwise Supabase ignores redirectTo and falls back to the Site URL.
VITE_SITE_URL=

# ---- Firebase Cloud Messaging (push notifications) ----
# PUBLIC web config for the existing Firebase project "hiil-model-school" (safe in the browser by
# design). Firebase is used for Cloud Messaging ONLY. Push is hidden in the UI until ALL of these are set.
# Get VITE_FIREBASE_API_KEY from Firebase console > Project settings > General > Your apps > Web app.
# NEVER put the service-account JSON / private_key / any server secret in a VITE_ variable: the
# server-side sender reads those from Supabase Edge Function secrets (see docs/PUSH_NOTIFICATIONS.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hiil-model-school.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hiil-model-school
VITE_FIREBASE_STORAGE_BUCKET=hiil-model-school.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=92461963016
VITE_FIREBASE_APP_ID=1:92461963016:web:74645bf4b93911996c7ebd
# Public Web Push (VAPID) key: Firebase console > Project settings > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=BJ8dxQRE6kEGmMKO4-gU5MygTSPwbXmfgOb6yCx_DZpVVdNDucab7n3Vn8j7mFRaR-J_7SEYzQPNQDy6s8GPsiA
