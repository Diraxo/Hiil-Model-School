# ---- Supabase (Auth, Postgres, RLS, Realtime, Edge Functions, Storage) ----
# This is a "publishable" key (sb_publishable_...) — safe for the browser.
# Never put a service_role/secret key here or anywhere in client code.
# All user-uploaded images/files live in PRIVATE Supabase Storage buckets and are
# reached through the authenticated client with short-lived signed URLs — there is
# nothing else to configure here for file storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Firebase Cloud Messaging (push notifications) ----
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
